#!/bin/sh
set -e

# Deliberately does not restart SpringBoard: that is what the package manager
# reports as a respring, and an install must not force one. Safari is only
# restarted so the tweak is picked up on its next launch; if it is not running
# nothing happens.
killall -9 MobileSafari 2>/dev/null || true
killall -9 com.apple.SafariViewService 2>/dev/null || true

exit 0
